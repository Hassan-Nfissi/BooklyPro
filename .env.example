# Domain & HTTPS (DuckDNS & Let's Encrypt SSL)
DOMAIN_NAME=yoursubdomain.duckdns.org
ACME_EMAIL=your-email@example.com

# Database (PostgreSQL)
POSTGRES_DB=booklypro
POSTGRES_USER=booklypro
POSTGRES_PASSWORD=booklypro_secret_change_in_prod

# Backend Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://yoursubdomain.duckdns.org

# Google OAuth (Token Exchange - Authorized JavaScript Origins: https://yoursubdomain.duckdns.org)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
